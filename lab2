#include <avr/io.h>
#include <stdint.h>
#include <avr/interrupt.h>
#define CPU_CLOCK_HZ 11059200UL
#define TIMER1_PRESCALER 64UL
#define SCAN_RATE_HZ 800UL
#define COLUMN_COUNT 16u
#define TICKS_PER_INVERT 2400u
#define CYCLE_TICKS 4800u

const uint8_t picture[2][COLUMN_COUNT] = {
	{
		0x07, 0x0F, 0x1B, 0xF3, 0xE3, 0x03, 0x03, 0x03, 0xE0, 0xF0, 0xD8, 0xCF, 0xC7, 0xC0, 0xC0, 0xC0},
		{0x03, 0x03, 0x03, 0xE3, 0xF3, 0x1B, 0x0F, 0x07, 0xC0, 0xC0, 0xC0, 0xC7, 0xCF, 0xD8, 0xF0, 0xE0}
	};
	ISR(TIMER1_COMPA_vect){
		static uint16_t ticks = 0;
		static const uint8_t masks[2] = {0x00, 0xFF};
		uint8_t column = ticks % COLUMN_COUNT;
		uint8_t mask = masks[ticks >= TICKS_PER_INVERT];
		uint8_t left = picture[0][column] ^ mask;
		uint8_t right = picture[1][column] ^ mask;
		PORTA = 0x00;
		PORTC = 0x00;
		PORTD = (PORTD & 0x0F) | (column << 4);
		PORTA = left;
		PORTC = right;
		ticks = (ticks + 1u) % CYCLE_TICKS;
	}
	int main(){
		PORTA = 0x00;
		PORTC = 0x00;
		PORTD &= 0x0F;
		DDRA = 0xFF;
		DDRC = 0xFF;
		DDRD |= 0xF0;
		TCCR1A = 0;
		TCCR1B = 0;
		TCNT1 = 0;
		OCR1A = CPU_CLOCK_HZ / TIMER1_PRESCALER / SCAN_RATE_HZ - 1UL;
		TIFR = (1 << OCF1A);
		TIMSK |= (1 << OCIE1A);
		TCCR1B = (1 << WGM12) | (1 << CS11) | (1 << CS10);
		sei();
		while(1){}
	}
	




















